#cloud-config
# Rendered by modules/p4-node.
#
# The provisioning scripts are embedded here rather than fetched. The obvious
# alternative -- pulling them from the checkpoint storage account -- does not
# work yet: that account has public network access disabled and there are no
# private endpoints, so nothing inside the VNet can reach it. Embedding needs no
# network and no credentials, and keeps the node identical to the Hyper-V path.
#
# custom_data is capped at 64 KB base64. The tree is currently about 19 KB, so
# there is room, but it is not unlimited. TODO(chris): once private endpoints
# exist, fetch from blob storage instead and drop this.
package_update: true

write_files:
  - path: /etc/p4-node-role
    content: "${role}"
%{ for name, content in provisioning_files ~}
  - path: /opt/p4-provisioning/${name}
    encoding: b64
    permissions: '0755'
    content: ${content}
%{ endfor ~}

runcmd:
  - [ bash, -lc, "/opt/p4-provisioning/provision.sh ${provision_args} 2>&1 | tee /var/log/p4-provision.log" ]
